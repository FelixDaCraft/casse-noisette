# Base de données (Postgres) — en local : pointe vers ta DB locale.
# En prod (homelab), le runner CI atteint Postgres via 127.0.0.1:5434.
DATABASE_URL="postgresql://casse:casse@127.0.0.1:5434/casse_noisette?schema=public"

# Postgres (utilisés par docker-compose en prod)
POSTGRES_USER="casse"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="casse_noisette"

# Secret de signature des sessions admin (openssl rand -hex 32)
SESSION_SECRET="change-me-32-chars-minimum-please-aaaaaa"

# Compte admin initial (créé par le seed s'il n'existe aucun admin)
SEED_ADMIN_EMAIL="admin@casse-noisette.local"
SEED_ADMIN_PASSWORD="change-me"

# URL publique
NEXT_PUBLIC_SITE_URL="https://casse-noisette.aynn.fr"

# SMTP — envoi des emails de reset de mot de passe (optionnel).
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=ton.email@gmail.com, SMTP_PASS=<mot de passe d'application Google 16 car.>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Casse-Noisette <ton.email@gmail.com>"

# ---------------------------------------------------------------------------
# Ordre de passage adapté au point de départ (page publique)
# ---------------------------------------------------------------------------
# Les panneaux d'un itinéraire sont réordonnés pour que le trajet soit le plus
# court depuis la position GPS du militant. Les distances viennent d'OSRM ; si
# le service ne répond pas, on retombe automatiquement sur le vol d'oiseau.
#
# RECOMMANDÉ — instance OSRM auto-hébergée (voir deploy/osrm/). Une URL par
# mode. Dès qu'une seule est définie, l'app passe en mode rapide : plus
# d'étranglement des requêtes ni d'affinage différé, l'ordre exact est calculé
# avant l'affichage. Depuis le conteneur web, l'hôte est la passerelle Docker
# (172.17.0.1), pas 127.0.0.1.
# OSRM_URL_DRIVING="http://172.17.0.1:5100"
# OSRM_URL_BICYCLING="http://172.17.0.1:5101"
# OSRM_URL_WALKING="http://172.17.0.1:5102"

# REPLI sans configuration : instance publique FOSSGIS. Elle fait patienter
# ~8 s par requête au-delà de la première, d'où l'affichage au vol d'oiseau
# puis l'affinage. Utilisable, mais pas instantané.
OSRM_BASE_URL="https://routing.openstreetmap.de"
# Les trois réglages ci-dessous ont des valeurs par défaut adaptées
# automatiquement selon qu'une instance dédiée est configurée ou non.
# OSRM_TIMEOUT_MS="15000"     # dédiée : 5000
# OSRM_MIN_GAP_MS="1200"      # dédiée : 0 (aucune file d'attente)
# OPTIMIZE_BUDGET_MS="2500"   # dédiée : 4000 (on attend, c'est rapide)
